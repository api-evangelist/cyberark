{
  "opencollection": "1.0.0",
  "info": {
    "name": "CyberArk Conjur Manager Authentication Secrets API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Secrets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve secret value",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://conjur.example.com/secrets/:account/:kind/:identifier",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path"
              },
              {
                "name": "kind",
                "value": "",
                "type": "path"
              },
              {
                "name": "identifier",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve secret value"
        },
        {
          "info": {
            "name": "Store secret value",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://conjur.example.com/secrets/:account/:kind/:identifier",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path"
              },
              {
                "name": "kind",
                "value": "",
                "type": "path"
              },
              {
                "name": "identifier",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Store secret value"
        }
      ]
    }
  ],
  "bundled": true
}
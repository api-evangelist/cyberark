{
  "opencollection": "1.0.0",
  "info": {
    "name": "CyberArk Conjur Secrets Manager Authentication Health API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Server information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://conjur.example.com/info"
          },
          "docs": "Server information"
        },
        {
          "info": {
            "name": "Health check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://conjur.example.com/health"
          },
          "docs": "Health check"
        }
      ]
    }
  ],
  "bundled": true
}